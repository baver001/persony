{
  "name": "persony",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/embed-git-sha.mjs && vite build",
    "deploy": "wrangler deploy",
    "preview": "vite preview",
    "dev:legacy": "tsx server.ts",
    "clean": "rm -rf dist .wrangler",
    "preci": "node scripts/check-deps.mjs",
    "lint": "node ./node_modules/typescript/lib/tsc.js --noEmit",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "ci": "npm run validate:i18n && npm run lint && npm test && npm run build",
    "smoke:economics:public": "node scripts/economics-smoke-public.mjs",
    "smoke:economics:owner": "node scripts/economics-smoke-owner.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types",
    "icons": "node scripts/generate-icons.mjs",
    "db:migrate:local": "wrangler d1 migrations apply persony-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply persony-db --remote"
  },
  "dependencies": {
    "@clerk/backend": "^3.17.2",
    "@clerk/clerk-react": "^5.61.9",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "hono": "^4.11.7",
    "i18next": "^26.4.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.7.5",
    "@cloudflare/workers-types": "^5.20260915.1",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.131.2",
    "ws": "^8.21.3"
  }
}
