# Скопируйте в .dev.vars для локальной разработки (wrangler dev)
GEMINI_API_KEY=your_gemini_api_key_here
ENVIRONMENT=development

# Локальная auth без Clerk (игнорируется при ENVIRONMENT=production)
PERSONY_DEV_MODE=true
PERSONY_DEV_USER_ID=dev-local-user

# Clerk (Phase 1b — после настройки Dashboard)
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
