# Скопируйте в .dev.vars для локальной разработки (wrangler dev)
GEMINI_API_KEY=your_gemini_api_key_here

# Локальная синхронизация custom personas без Clerk (не использовать в production)
PERSONY_DEV_MODE=true
PERSONY_DEV_USER_ID=dev-local-user

# Clerk (Phase 1 — после настройки Dashboard)
# CLERK_SECRET_KEY=
# VITE_CLERK_PUBLISHABLE_KEY=pk_...

# Multi-provider AI (Phase 2)
# DEEPSEEK_API_KEY=
# PERSONY_TEXT_PROVIDER=deepseek
# PERSONY_ENABLE_DEEPSEEK=true

# Paddle billing (Phase 4)
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
